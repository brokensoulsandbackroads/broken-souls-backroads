# Broken Souls & Backroads - server-side API configuration
# Copy these names into your serverless host's private environment settings.
# NEVER put real secrets in this file or commit a .env file.

# Two Fifteen credentials
TWO_FIFTEEN_APP_ID=
TWO_FIFTEEN_SECRET_KEY=

# Private token used to protect the BS&B server-to-server order route.
# Generate a long random value and keep it server-side only.
BSB_API_INTERNAL_TOKEN=

# Direct Two Fifteen API contract. Leave blank until confirmed by Two Fifteen.
TWO_FIFTEEN_ORDER_URL=
TWO_FIFTEEN_AUTH_MODE=
TWO_FIFTEEN_APP_ID_HEADER=
TWO_FIFTEEN_SECRET_HEADER=
TWO_FIFTEEN_LIVE_SUBMIT=false

# Same Roads, Different Stories Tee
TWO_FIFTEEN_TEE_PRODUCT_CODE=
TWO_FIFTEEN_TEE_FRONT_ART_URL=
TWO_FIFTEEN_TEE_FRONT_LOCATION=
TWO_FIFTEEN_TEE_FRONT_TYPE=

# BS&B Roadside Hoodie
TWO_FIFTEEN_HOODIE_PRODUCT_CODE=
TWO_FIFTEEN_HOODIE_FRONT_ART_URL=
TWO_FIFTEEN_HOODIE_FRONT_LOCATION=
TWO_FIFTEEN_HOODIE_FRONT_TYPE=
TWO_FIFTEEN_HOODIE_BACK_ART_URL=
TWO_FIFTEEN_HOODIE_BACK_LOCATION=
TWO_FIFTEEN_HOODIE_BACK_TYPE=

# Same Roads Two-Tone Mug
TWO_FIFTEEN_MUG_PRODUCT_CODE=
TWO_FIFTEEN_MUG_WRAP_ART_URL=
TWO_FIFTEEN_MUG_WRAP_LOCATION=
TWO_FIFTEEN_MUG_WRAP_TYPE=
